<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup 已经关掉，这个文件是给 Android 12+ 的 dataExtractionRules 兜底：
  即使哪天有人把 allowBackup 打开，也不让数据库、设置、图片进入云备份或设备迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
